<% content_for :title, title %>
<div class="card auth-card mx-auto mt-md-5 shadow-sm">
  <div class="card-body p-4">
    <h1 class="h4 mb-4"><%= heading %></h1>
    <%= yield %>
    <p class="mt-3 mb-0 text-center small">
      <%= prompt %> <%= link_to link_label, link_path %>
    </p>
  </div>
</div>
