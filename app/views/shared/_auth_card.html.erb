<% content_for :title, title %>
<div class="auth-wrap">
  <div class="card auth-card">
    <div class="card-body">
      <h1 class="auth-title"><%= heading %></h1>
      <p class="auth-subtitle">User Management admin panel</p>
      <%= yield %>
    </div>
  </div>
  <p class="auth-switch"><%= prompt %> <%= link_to link_label, link_path %></p>
</div>
