<div id="flash">
  <% flash_messages.each do |message, style| %>
    <div class="alert app-alert alert-<%= style %> alert-dismissible" role="alert">
      <i class="bi bi-<%= style == "success" ? "check-circle" : "exclamation-circle" %>"></i>
      <span><%= message %></span>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% end %>
</div>
