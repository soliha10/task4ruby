<% examples = [
  "How many users are blocked?",
  "Select users whose e-mail starts with s or p",
  "Which e-mail domains are the most common?",
  "Show only blocked users",
  "Sort the table by name"
] %>
<div class="card chat-card" id="assistant">
  <div class="chat-header">
    <div class="min-w-0">
      <h2 class="chat-title">Assistant</h2>
      <div class="chat-subtitle">Ask about users or control the table</div>
    </div>
    <button type="button" class="icon-btn ms-auto" id="chat-clear" data-bs-toggle="tooltip" title="Clear the conversation" aria-label="Clear the conversation">
      <i class="bi bi-arrow-counterclockwise"></i>
    </button>
  </div>
  <div class="chat-messages" id="chat-messages" aria-live="polite">
    <div id="chat-hint">
      <div class="chat-hint-title">Try asking</div>
      <div class="chip-list">
        <% examples.each do |example| %>
          <button type="button" class="chat-chip"><%= example %></button>
        <% end %>
      </div>
    </div>
  </div>
  <div class="chat-footer">
    <form id="chat-form" class="chat-form" autocomplete="off">
      <input type="text" class="form-control" id="chat-input" placeholder="Ask a question or give a command…" aria-label="Message" required>
      <button type="submit" class="btn btn-primary chat-send" id="chat-send" aria-label="Send">
        <i class="bi bi-send"></i>
      </button>
    </form>
  </div>
</div>
