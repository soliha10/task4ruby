<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "User Management" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <script>
      (() => {
        let theme = null;
        try { theme = localStorage.getItem("theme"); } catch {}
        if (!theme) theme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.setAttribute("data-bs-theme", theme);
      })();
    </script>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <%= stylesheet_link_tag :app %>
  </head>

  <body>
    <header class="app-header">
      <div class="app-header-inner">
        <%= link_to root_path, class: "app-brand" do %>
          <span class="brand-mark">U</span><span class="brand-text">User Management</span>
        <% end %>
        <div class="d-flex align-items-center gap-2 ms-auto">
          <% if current_user %>
            <div class="header-user d-none d-sm-flex">
              <span class="avatar-soft"><%= user_initials(current_user) %></span>
              <div class="min-w-0">
                <div class="header-user-name text-truncate"><%= current_user.name %></div>
                <div class="header-user-email text-truncate"><%= current_user.email %></div>
              </div>
            </div>
          <% end %>
          <button type="button" class="icon-btn" id="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">
            <i class="bi bi-moon theme-icon-light"></i><i class="bi bi-sun theme-icon-dark"></i>
          </button>
          <% if current_user %>
            <%= button_to logout_path, method: :delete, class: "btn btn-tool", form_class: "d-inline" do %>
              <i class="bi bi-box-arrow-right"></i><span class="d-none d-sm-inline ms-1">Log out</span>
            <% end %>
          <% end %>
        </div>
      </div>
    </header>

    <main class="app-main">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script>
      document.getElementById("theme-toggle").addEventListener("click", () => {
        const theme = document.documentElement.getAttribute("data-bs-theme") === "dark" ? "light" : "dark";
        document.documentElement.setAttribute("data-bs-theme", theme);
        try { localStorage.setItem("theme", theme); } catch {}
      });
    </script>
    <%= yield :scripts %>
  </body>
</html>
