<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "User Management" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <%= stylesheet_link_tag :app %>
  </head>

  <body class="bg-body-tertiary">
    <nav class="navbar navbar-expand-md bg-dark border-bottom" data-bs-theme="dark">
      <div class="container-fluid">
        <%= link_to root_path, class: "navbar-brand" do %>
          <i class="bi bi-people me-1"></i> User Management
        <% end %>
        <% if current_user %>
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav ms-auto align-items-md-center">
              <li class="nav-item">
                <span class="navbar-text me-md-3">
                  <i class="bi bi-person-circle me-1"></i><%= current_user.name %>
                  <span class="text-white-50">(<%= current_user.email %>)</span>
                </span>
              </li>
              <li class="nav-item">
                <%= button_to logout_path, method: :delete, class: "btn btn-link nav-link px-0" do %>
                  <i class="bi bi-box-arrow-right me-1"></i>Logout
                <% end %>
              </li>
            </ul>
          </div>
        <% end %>
      </div>
    </nav>

    <main class="container-fluid py-3">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <%= yield :scripts %>
  </body>
</html>
